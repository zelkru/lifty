# Copiar como ".env" y completar. Es opcional: sin .env se usan los valores de XAMPP y los correos se simulan.

DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASS=
DB_NAME=lifty_bd

# Correo con Gmail (contraseña de aplicación, requiere verificación en dos pasos)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=tls
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_FROM_NAME=Lifty
